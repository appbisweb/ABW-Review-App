# =============================================================================
# ABW Review App - Environment Variables
# =============================================================================
# Copy this file to `.env` and fill in the values.
# Never commit your actual `.env` file to version control!

# =============================================================================
# REQUIRED
# =============================================================================

# Your Google Business Profile review link
# Get it from: https://support.google.com/business/answer/7035772
PUBLIC_GOOGLE_PROFILE=https://search.google.com/local/writereview?placeid=YOUR_PLACE_ID

# =============================================================================
# AI PROVIDER CONFIGURATION
# =============================================================================

# Choose your AI provider: "openai" or "anthropic" (default: openai)
AI_PROVIDER=openai

# --- OpenAI (required if AI_PROVIDER=openai) ---
SECRET_OPENAI=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# --- Anthropic (required if AI_PROVIDER=anthropic) ---
# SECRET_ANTHROPIC=sk-ant-your-anthropic-api-key-here
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# =============================================================================
# OPTIONAL - Brand Customization
# =============================================================================

# Your brand/business name displayed in the UI
PUBLIC_BRAND_NAME=App bis Web

# The name of the person/owner for personalized reviews
PUBLIC_OWNER_NAME=Jan

# Provider mode: "solo" for individuals, "team" for companies
PUBLIC_PROVIDER_MODE=solo

# Pronoun for the provider (German: er/sie)
PUBLIC_PROVIDER_PRONOUN=er

# Default review style: authentisch, locker, sachlich, begeistert, kurz
PUBLIC_REVIEW_STYLE=authentisch
